#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BINARY="$SCRIPT_DIR/scripts/dmp-index/target/release/dmp-index"

if [ ! -f "$BINARY" ] && command -v cargo &>/dev/null; then
  echo "Binary not found. Building..."
  (cd "$SCRIPT_DIR/scripts" && cargo build --release -p dmp-index)
fi

if [ -f "$BINARY" ]; then
  exec "$BINARY" "$@"
fi

# Docker fallback (NAS)
source "$SCRIPT_DIR/scripts/_docker_run"
_dmp_run dmp-index "$@"
