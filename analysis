#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BINARY="$SCRIPT_DIR/scripts/analysis/target/release/analysis"
REPORTS_DIR="$SCRIPT_DIR/reports"

if [ -f "$BINARY" ]; then
  mkdir -p "$REPORTS_DIR"

  has_output_dir=false
  for arg in "$@"; do
    if [[ "$arg" == --output-dir* ]]; then
      has_output_dir=true
      break
    fi
  done

  if [ "$has_output_dir" = false ]; then
    exec "$BINARY" "$@" --output-dir "$REPORTS_DIR"
  else
    exec "$BINARY" "$@"
  fi
fi

# Docker fallback (NAS)
if [ -f "$SCRIPT_DIR/scripts/_docker_run" ]; then
  source "$SCRIPT_DIR/scripts/_docker_run"
elif [ -f "$SCRIPT_DIR/_docker_run" ]; then
  source "$SCRIPT_DIR/_docker_run"
else
  echo "Error: Binary not found. Build with: cd scripts/analysis && cargo build --release" >&2
  exit 1
fi
_dmp_run dmp-analysis "$@"
