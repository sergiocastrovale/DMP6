#!/usr/bin/env bash
# Creates symlinks from MUSIC_DIR into web/dump/test-artists for a curated set of artist folders.
# Used with ./sync --test to run against a small subset of the library.

# Artist folders to symlink
ARTISTS=(
    "070 Shake"
    "AC DC"
    "...And Oceans"
    "Crosby, Stills, Nash & Young"
    "Ayreon"
    "Tyler, The Creator"
    "Godley & Creme"
    "FŒHN"
)

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TARGET_DIR="$SCRIPT_DIR/web/dump/test-artists"

# Load MUSIC_DIR from web/.env
ENV_FILE="$SCRIPT_DIR/web/.env"
if [ ! -f "$ENV_FILE" ]; then
    echo "Error: $ENV_FILE not found"
    exit 1
fi
MUSIC_DIR=$(grep -E '^MUSIC_DIR=' "$ENV_FILE" | head -1 | cut -d'=' -f2-)
if [ -z "$MUSIC_DIR" ]; then
    echo "Error: MUSIC_DIR not set in $ENV_FILE"
    exit 1
fi


# Clean and recreate target directory
rm -rf "$TARGET_DIR"
mkdir -p "$TARGET_DIR"

linked=0
missing=0
for artist in "${ARTISTS[@]}"; do
    src="$MUSIC_DIR/$artist"
    if [ -d "$src" ]; then
        ln -s "$src" "$TARGET_DIR/$artist"
        echo "  ✓ $artist"
        linked=$((linked + 1))
    else
        echo "  ✗ $artist (not found in $MUSIC_DIR)"
        missing=$((missing + 1))
    fi
done

echo ""
echo "Linked $linked artist(s) in $TARGET_DIR"
if [ $missing -gt 0 ]; then
    echo "Missing: $missing"
    exit 1
fi
