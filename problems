#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Note target/scan, not target/release: `problems` needs panic="unwind" so a corrupt file costs one
# row instead of the whole run. See [profile.scan] in scripts/Cargo.toml.
BINARY="$SCRIPT_DIR/scripts/target/scan/problems"

if [ ! -f "$BINARY" ] && command -v cargo &>/dev/null; then
  echo "Binary not found. Building (scan profile: panic=unwind)..."
  (cd "$SCRIPT_DIR/scripts" && cargo build --profile scan -p problems --quiet)
fi

if [ -f "$BINARY" ]; then
  exec "$BINARY" "$@"
fi

# Docker fallback (NAS - binary is inside the running container)
TTY_FLAG=""; [ -t 0 ] && TTY_FLAG="-it"
exec docker exec $TTY_FLAG dmp problems "$@"
