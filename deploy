#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "$0")" && pwd)"

if [ -f "$PROJECT_ROOT/web/.env" ]; then
  set -a
  source "$PROJECT_ROOT/web/.env"
  set +a
fi

NAS_HOST="${SERVER_HOST:?SERVER_HOST not set in .env}"
NAS_USER="${SERVER_USER:?SERVER_USER not set in .env}"
NAS_DEPLOY_PATH="${DEPLOY_PATH:-/mnt/pool/appdata/dmp}"
SSH_KEY="${SSH_KEY_PATH:-}"

SSH_OPTS=""
if [ -n "$SSH_KEY" ]; then
  SSH_OPTS="-i $SSH_KEY"
fi

ssh_cmd() { ssh $SSH_OPTS "$NAS_USER@$NAS_HOST" "$@"; }
scp_cmd() { scp $SSH_OPTS "$@"; }

echo "=== DMP Deploy ==="
echo "Target: $NAS_USER@$NAS_HOST:$NAS_DEPLOY_PATH"
echo ""

# Build
echo "--- Building image ---"
docker build -t dmp:latest "$PROJECT_ROOT"
echo ""

# Transfer
echo "--- Saving image ---"
ARCHIVE="/tmp/dmp-image.tar.gz"
docker save dmp:latest | gzip > "$ARCHIVE"
SIZE=$(du -h "$ARCHIVE" | cut -f1)
echo "Archive size: $SIZE"

echo "--- Transferring to NAS ---"
scp_cmd "$ARCHIVE" "$NAS_USER@$NAS_HOST:/tmp/dmp-image.tar.gz"

echo "--- Loading image on NAS ---"
ssh_cmd "sudo docker load < /tmp/dmp-image.tar.gz && rm /tmp/dmp-image.tar.gz"
rm "$ARCHIVE"
echo ""

# Deploy compose + script wrappers
echo "--- Deploying ---"
ssh_cmd "mkdir -p $NAS_DEPLOY_PATH"
scp_cmd "$PROJECT_ROOT/docker-compose.yml" "$NAS_USER@$NAS_HOST:$NAS_DEPLOY_PATH/"
scp_cmd "$PROJECT_ROOT/index" "$PROJECT_ROOT/sync" "$PROJECT_ROOT/refresh" "$PROJECT_ROOT/audit" "$PROJECT_ROOT/fix" "$PROJECT_ROOT/nuke" "$PROJECT_ROOT/analysis" "$PROJECT_ROOT/playlists" "$PROJECT_ROOT/delete" "$PROJECT_ROOT/dissect" "$PROJECT_ROOT/dmp-songkong-scan.sh" "$PROJECT_ROOT/dmp-songkong-drain.sh" "$NAS_USER@$NAS_HOST:$NAS_DEPLOY_PATH/"
ssh_cmd "chmod +x $NAS_DEPLOY_PATH/index $NAS_DEPLOY_PATH/sync $NAS_DEPLOY_PATH/refresh $NAS_DEPLOY_PATH/audit $NAS_DEPLOY_PATH/fix $NAS_DEPLOY_PATH/nuke $NAS_DEPLOY_PATH/analysis $NAS_DEPLOY_PATH/playlists $NAS_DEPLOY_PATH/delete $NAS_DEPLOY_PATH/dissect $NAS_DEPLOY_PATH/dmp-songkong-scan.sh $NAS_DEPLOY_PATH/dmp-songkong-drain.sh"

echo "--- Ensuring SongKong spool dirs ---"
SONGKONG_STATE="${DOWNLOADS_DIR:-/mnt/SSD/Downloads}/.dmp-songkong"
ssh_cmd "sudo mkdir -p $SONGKONG_STATE/spool $SONGKONG_STATE/done && sudo chmod -R 777 $SONGKONG_STATE && sudo touch $SONGKONG_STATE/scan.lock $SONGKONG_STATE/drain.lock && sudo chmod 666 $SONGKONG_STATE/scan.lock $SONGKONG_STATE/drain.lock"

echo "--- Ensuring approved-downloads dir ---"
APPROVED_DIR="${DOWNLOADS_APPROVED_FOLDER_HOST:-${DOWNLOADS_DIR:-/mnt/SSD/Downloads}/_approved}"
ssh_cmd "sudo mkdir -p $APPROVED_DIR && sudo chmod 777 $APPROVED_DIR"

echo "--- Ensuring data dir permissions ---"
ssh_cmd "mkdir -p $NAS_DEPLOY_PATH/img/releases $NAS_DEPLOY_PATH/img/artists $NAS_DEPLOY_PATH/dump && chmod 777 $NAS_DEPLOY_PATH/img $NAS_DEPLOY_PATH/img/releases $NAS_DEPLOY_PATH/img/artists $NAS_DEPLOY_PATH/dump"

echo "--- Restarting container ---"
ssh_cmd "cd $NAS_DEPLOY_PATH && sudo docker compose up -d web"

echo "--- Applying DB schema ---"
ssh_cmd "cd $NAS_DEPLOY_PATH && sleep 3 && sudo docker compose exec -T web prisma db push --schema=prisma/schema.prisma --accept-data-loss 2>&1 || true"

# Clean up old images (after restart so the old image is no longer in use)
echo "--- Cleaning up old images ---"
ssh_cmd "sudo docker image prune -f 2>/dev/null || true"
echo ""

echo "=== Done ==="
