#!/usr/bin/env bash
set -euo pipefail

PROJECT_ROOT="$(cd "$(dirname "$0")" && pwd)"

if [ -f "$PROJECT_ROOT/web/.env" ]; then
  set -a
  source "$PROJECT_ROOT/web/.env"
  set +a
fi

NAS_HOST="${SERVER_HOST:?SERVER_HOST not set in .env}"
NAS_USER="${SERVER_USER:?SERVER_USER not set in .env}"
NAS_DEPLOY_PATH="${DEPLOY_PATH:-/mnt/pool/appdata/dmp}"
SSH_KEY="${SSH_KEY_PATH:-}"

SSH_OPTS=""
if [ -n "$SSH_KEY" ]; then
  SSH_OPTS="-i $SSH_KEY"
fi

ssh_cmd() { ssh $SSH_OPTS "$NAS_USER@$NAS_HOST" "$@"; }
scp_cmd() { scp $SSH_OPTS "$@"; }

echo "=== DMP Deploy ==="
echo "Target: $NAS_USER@$NAS_HOST:$NAS_DEPLOY_PATH"
echo ""

# Lint + typecheck (fail loudly before wasting a build on broken code)
echo "--- Lint + typecheck ---"
(cd "$PROJECT_ROOT/web" && pnpm lint && pnpm typecheck)
echo ""

# Build
echo "--- Building image ---"
docker build -t dmp:latest "$PROJECT_ROOT"
echo ""

# Transfer
echo "--- Saving image ---"
ARCHIVE="/tmp/dmp-image.tar.gz"
docker save dmp:latest | gzip > "$ARCHIVE"
SIZE=$(du -h "$ARCHIVE" | cut -f1)
echo "Archive size: $SIZE"

echo "--- Transferring to NAS ---"
scp_cmd "$ARCHIVE" "$NAS_USER@$NAS_HOST:/tmp/dmp-image.tar.gz"

echo "--- Loading image on NAS ---"
ssh_cmd "sudo docker load < /tmp/dmp-image.tar.gz && rm /tmp/dmp-image.tar.gz"
rm "$ARCHIVE"
echo ""

# Deploy compose + script wrappers
echo "--- Deploying ---"
ssh_cmd "mkdir -p $NAS_DEPLOY_PATH"
scp_cmd "$PROJECT_ROOT/docker-compose.yml" "$NAS_USER@$NAS_HOST:$NAS_DEPLOY_PATH/"
scp_cmd "$PROJECT_ROOT/index" "$PROJECT_ROOT/sync" "$PROJECT_ROOT/tidy" "$PROJECT_ROOT/add" "$PROJECT_ROOT/refresh" "$PROJECT_ROOT/audit" "$PROJECT_ROOT/fix" "$PROJECT_ROOT/nuke" "$PROJECT_ROOT/analysis" "$PROJECT_ROOT/playlists" "$PROJECT_ROOT/delete" "$PROJECT_ROOT/dissect" "$PROJECT_ROOT/problems" "$PROJECT_ROOT/extract-meta-images" "$PROJECT_ROOT/artist-photos" "$NAS_USER@$NAS_HOST:$NAS_DEPLOY_PATH/"
ssh_cmd "chmod +x $NAS_DEPLOY_PATH/index $NAS_DEPLOY_PATH/sync $NAS_DEPLOY_PATH/tidy $NAS_DEPLOY_PATH/add $NAS_DEPLOY_PATH/refresh $NAS_DEPLOY_PATH/audit $NAS_DEPLOY_PATH/fix $NAS_DEPLOY_PATH/nuke $NAS_DEPLOY_PATH/analysis $NAS_DEPLOY_PATH/playlists $NAS_DEPLOY_PATH/delete $NAS_DEPLOY_PATH/dissect $NAS_DEPLOY_PATH/problems $NAS_DEPLOY_PATH/extract-meta-images $NAS_DEPLOY_PATH/artist-photos"

# Monitoring host scripts (SongKong enrichment cron + bundled enrich-only profile).
ssh_cmd "mkdir -p $NAS_DEPLOY_PATH/scripts/monitor"
scp_cmd "$PROJECT_ROOT/scripts/monitor/songkong-scan.sh" "$PROJECT_ROOT/scripts/monitor/songkong-drain.sh" "$PROJECT_ROOT/scripts/monitor/songkong_fixsongs_dmp.properties" "$NAS_USER@$NAS_HOST:$NAS_DEPLOY_PATH/scripts/monitor/"
ssh_cmd "chmod +x $NAS_DEPLOY_PATH/scripts/monitor/songkong-scan.sh $NAS_DEPLOY_PATH/scripts/monitor/songkong-drain.sh"

DL_ROOT="${DOWNLOADS_DIR:-/mnt/SSD/Downloads}"

echo "--- Ensuring SongKong spool dirs ---"
SONGKONG_STATE="$DL_ROOT/.dmp-songkong"
ssh_cmd "sudo mkdir -p $SONGKONG_STATE/spool $SONGKONG_STATE/done && sudo chmod -R 777 $SONGKONG_STATE && sudo touch $SONGKONG_STATE/scan.lock $SONGKONG_STATE/drain.lock && sudo chmod 666 $SONGKONG_STATE/scan.lock $SONGKONG_STATE/drain.lock"

echo "--- Ensuring downloads dir (gid 568, setgid so slskd+dmp share) ---"
ssh_cmd "sudo mkdir -p '$DL_ROOT/dmp/_approved' && sudo chown -R :568 '$DL_ROOT/dmp' && sudo chmod -R 2775 '$DL_ROOT/dmp'"

echo "--- Ensuring data dir permissions ---"
ssh_cmd "mkdir -p $NAS_DEPLOY_PATH/img/releases $NAS_DEPLOY_PATH/img/artists $NAS_DEPLOY_PATH/dump $NAS_DEPLOY_PATH/logs && chmod 777 $NAS_DEPLOY_PATH/img $NAS_DEPLOY_PATH/img/releases $NAS_DEPLOY_PATH/img/artists $NAS_DEPLOY_PATH/dump $NAS_DEPLOY_PATH/logs"

# Migrate BEFORE swapping the container. The old order (restart, sleep 3, migrate) ran new code against the old
# schema for however long the migrations took - seconds for a column, minutes while an index builds - and, if a
# migration failed, left the new code running against the old schema indefinitely. A one-off container from the
# NEW image applies the migrations while the OLD container keeps serving; `set -e` stops the deploy on failure
# with the old container still up.
MIGRATE="cd $NAS_DEPLOY_PATH && sudo docker compose run --rm --no-deps -T web prisma"
echo "--- Checking pending DB migrations ---"
PENDING="$(ssh_cmd "$MIGRATE migrate status --schema=prisma/schema.prisma" 2>&1 || true)"
echo "$PENDING" | tail -n 12
# Migrations named drop_dead_* / drop_column_* / drop_table_* remove columns or tables - unlike index changes they
# are not recoverable from a re-index. Make sure there is a backup before letting them run.
if echo "$PENDING" | grep -qE 'drop_(dead|column|table)'; then
  echo ""
  echo "WARNING: pending migrations DROP data (columns/tables). Take a backup first: ./backup"
  if [ -t 0 ] && [ -z "${DEPLOY_ASSUME_BACKUP:-}" ]; then
    read -r -p "Continue deploying? [y/N] " answer
    [ "$answer" = "y" ] || { echo "Aborted - nothing was changed."; exit 1; }
  fi
fi

echo "--- Applying DB migrations (new image, before restart) ---"
ssh_cmd "$MIGRATE migrate deploy --schema=prisma/schema.prisma"

echo "--- Restarting container ---"
ssh_cmd "cd $NAS_DEPLOY_PATH && sudo docker compose up -d web"

# Clean up old images (after restart so the old image is no longer in use)
echo "--- Cleaning up old images ---"
ssh_cmd "sudo docker image prune -f 2>/dev/null || true"
echo ""

echo "=== Done ==="
