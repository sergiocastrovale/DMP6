#!/usr/bin/env bash
#
# Run the Rust test suite, including the #[ignore]d database integration tests, against a throwaway
# PostgreSQL with the Prisma migrations applied. Never touches DATABASE_URL.
#
# Usage:
#   scripts/test-db [cargo test args...]      e.g. scripts/test-db -p index
#
# Env:
#   TEST_DATABASE_URL  use an existing disposable, empty database instead of starting a container
#   TEST_DB_PORT       host port for the container (default 55432)
#   DMP_LIVE_MB=1      also run tests that call the live MusicBrainz API
#
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
CONTAINER=""

cleanup() {
  if [ -n "$CONTAINER" ]; then
    docker stop "$CONTAINER" >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

if [ -n "${TEST_DATABASE_URL:-}" ]; then
  DB_URL="$TEST_DATABASE_URL"
else
  PORT="${TEST_DB_PORT:-55432}"
  CONTAINER="dmp-test-db-$$"
  docker run -d --rm --name "$CONTAINER" \
    -e POSTGRES_USER=dmp -e POSTGRES_PASSWORD=dmp -e POSTGRES_DB=dmp_test \
    -e LANG=en_US.utf8 \
    -p "127.0.0.1:${PORT}:5432" "${TEST_PG_IMAGE:-postgres:18.4}" >/dev/null
  for _ in $(seq 1 60); do
    if docker exec "$CONTAINER" pg_isready -h 127.0.0.1 -U dmp -d dmp_test >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
  DB_URL="postgresql://dmp:dmp@127.0.0.1:${PORT}/dmp_test"
fi

(cd "$ROOT/web" && DATABASE_URL="$DB_URL" pnpm exec prisma migrate deploy >/dev/null)

# A schema.prisma change without a migration is drift. Indexes Prisma cannot declare (btree operator
# classes, GIN trigram) are created by raw migrations and listed here so their "DROP INDEX" is not reported.
RAW_INDEXES='LocalReleaseTrack_filePath_pattern_idx|LocalRelease_folderPath_pattern_idx|LocalReleaseTrack_title_trgm_idx|LocalRelease_title_trgm_idx|MusicBrainzRelease_title_trgm_idx|Artist_name_trgm_idx|LocalReleaseTrack_lower_title_pattern_idx|LocalReleaseTrack_lowBitrate_idx|LocalReleaseTrack_title_id_idx'
DRIFT="$(cd "$ROOT/web" && pnpm exec prisma migrate diff --from-url "$DB_URL" \
  --to-schema-datamodel prisma/schema.prisma --script 2>/dev/null \
  | grep -vE "^--|^\s*$|^DROP INDEX \"(${RAW_INDEXES})\";$" || true)"
if [ -n "$DRIFT" ]; then
  echo "Schema drift: prisma/schema.prisma and the migrations disagree:" >&2
  echo "$DRIFT" >&2
  exit 1
fi

cd "$ROOT/scripts"
SMOKE_TEST_DATABASE_URL="$DB_URL" cargo test --workspace --no-fail-fast "$@" -- --include-ignored --test-threads=1
