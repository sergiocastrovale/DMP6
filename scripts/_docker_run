#!/usr/bin/env bash
# Docker run helper for NAS deployment.
# Expects SCRIPT_DIR to be set by the calling script.

if [ -f "$SCRIPT_DIR/.env" ]; then
  set -a
  source "$SCRIPT_DIR/.env"
  set +a
fi

MUSIC_DIR="${MUSIC_DIR:?MUSIC_DIR not set in .env}"
DMP_DATA="${DMP_DATA:?DMP_DATA not set in .env}"

_dmp_run() {
  local binary="$1"
  shift
  # Pass -t when stdout is a TTY so Rust color libraries see isatty()=true.
  local tty_flag=""
  [ -t 1 ] && tty_flag="-t"
  exec docker run --rm $tty_flag \
    --env-file "$SCRIPT_DIR/.env" \
    --add-host=host.docker.internal:host-gateway \
    -e PROJECT_ROOT=/app \
    -e MUSIC_DIR=/music \
    -v "$MUSIC_DIR:/music:ro" \
    -v "$DMP_DATA/img:/app/web/public/img" \
    dmp-scripts:latest \
    "$binary" "$@"
}
