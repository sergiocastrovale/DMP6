# IMPORTANT NOTE
# Some variables (downloads, storage, Fanart.tv) can also be set via the Settings DB table.
# The DB values override the env vars.

# ────────────────────────────────────────────────
# ──────────────────── Config ────────────────────
# ────────────────────────────────────────────────

# Include connection_limit and pool_timeout query params for Prisma if necessary
DATABASE_URL=postgresql://user:password@host:5432/dbname?connection_limit=20&pool_timeout=10

# Redis server-side response caching. Leave empty to disable.
# Automatically configured by docker-compose.yml in production.
REDIS_URL=

# Absolute path to music library root. Must be mounted locally (WSL2 can't use UNC paths directly).
# To mount NAS share in WSL2:
# sudo mount -t cifs //192.168.1.241/music /mnt/dmp/music -o username=MY_USER,uid=$(id -u),gid=$(id -g)
MUSIC_DIR=

# Absolute path to the DMP project folder.
# Used by Rust scripts to locate config and image directories.
PROJECT_ROOT=

# ────────────────────────────────────────────────
# ──────────────── Remote Server ─────────────────
# ────────────────────────────────────────────────

# NAS IP or hostname for deployment.
SERVER_HOST=

# SSH user on the NAS.
SERVER_USER=

# Path to SSH private key for NAS access.
SSH_KEY_PATH=~/.ssh/nas

# Absolute path on the NAS where the app is deployed.
DEPLOY_PATH=

# Optional. Used when the catalogue data lives on a different machine.
# Proxies images and audio to this URL (e.g. http://192.168.1.241:3000) if files are missing locally.
# Affects /img/artists/*, /img/releases/*, and /api/audio/*.
REMOTE_SERVER_URL=

# ────────────────────────────────────────────────
# ──────────────────── Storage ───────────────────
# ────────────────────────────────────────────────

# Where images are stored. Values: local, s3, or both (local preferred, S3 as fallback).
IMAGE_STORAGE=local

# Where backups are stored. Values: local or s3.
BACKUP_STORAGE=local

# S3-compatible object storage (AWS S3, Backblaze B2, MinIO, etc). S3 is the default protocol.
STORAGE_IMAGE_BUCKET=
STORAGE_BACKUPS_BUCKET=backups

# Public base URL for serving images. Used by the frontend to build image URLs.
# Format: https://bucket-name.s3.region.amazonaws.com
STORAGE_PUBLIC_URL=

# Custom endpoint for non-AWS S3-compatible services. Leave empty for AWS S3.
# Example: https://s3.us-west-004.backblazeb2.com
STORAGE_ENDPOINT=

# AWS config
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ────────────────────────────────────────────────
# ───────────────── Downloads ────────────────────
# ────────────────────────────────────────────────
# Download settings can also be configured via the Settings DB table (DB values take priority).

# Where downloaded files are written.
#   Local dev: absolute path on your machine (e.g. /home/you/Downloads/dmp)
#   Docker: set DOWNLOADS_DIR instead - docker-compose.yml mounts it and hard-codes DOWNLOADS_PATH=/downloads
DOWNLOADS_PATH=

# Host-side directory mounted into Docker containers at /downloads. Only used by docker-compose.yml.
DOWNLOADS_DIR=

# Folder structure template for downloads. Placeholders: {artist}, {album}, {year}.
# Slashes create nested folders. If {year} is unknown, surrounding separators collapse.
DOWNLOAD_DIR_TEMPLATE='{artist}/{year} - {album}'

# Comma-separated list of accepted audio formats (e.g. flac,mp3).
DOWNLOAD_FORMATS=flac,mp3

# Minimum bitrate in kbps for download quality filtering.
DOWNLOAD_MIN_BITRATE=320

# URL of the slskd (Soulseek) instance.
SLSKD_URL=http://localhost:5030

# API key for slskd authentication.
SLSKD_API_KEY=


# ────────────────────────────────────────────────
# ──────────────────── Other ─────────────────────
# ────────────────────────────────────────────────

# API key for Fanart.tv. Used to fetch artist images during sync.
FANART_API_KEY=