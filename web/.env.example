# See docs/variables.md for full documentation.

# Auth
ADMIN_USER=
ADMIN_PASSWORD=

# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?connection_limit=20&pool_timeout=10
REDIS_URL=

# Paths
MUSIC_DIR=/path/to/your/music/library
PROJECT_ROOT=/path/to/DMPv6

# Images
IMAGE_STORAGE=local
NAS_URL=

# S3
BACKUP_STORAGE=local
S3_IMAGE_BUCKET=
S3_BACKUPS_BUCKET=backups
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_PUBLIC_URL=

# External APIs
FANART_API_KEY=

# Deployment
SERVER_HOST=
SERVER_USER=
DEPLOY_PATH=/mnt/SSD/web/dmp
SSH_KEY_PATH=~/.ssh/nas

# Downloads
DOWNLOADS_PATH=/path/to/downloads
DOWNLOADS_DIR=/mnt/SSD/Downloads
DOWNLOAD_DIR_TEMPLATE='{artist}/{year} - {album}'
DOWNLOAD_FORMATS=flac,mp3
DOWNLOAD_MIN_BITRATE=320
SLSKD_URL=http://localhost:5030
SLSKD_API_KEY=
DEEZER_ARL=
