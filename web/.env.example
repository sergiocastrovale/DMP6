# Local path to your music library.
# If you want to use the NAS music library, you need to mount it first.
# In WSL2 you can't use \\nas\... paths — mount the NAS share first:
# sudo apt install cifs-utils
# sudo mkdir -p /mnt/dmp/music
# sudo mount -t cifs //192.168.1.241/music /mnt/dmp/music -o username=Kp,uid=$(id -u),gid=$(id -g)
# To make it permanent, add to /etc/fstab:
# //192.168.1.241/music /mnt/dmp/music cifs username=Kp,password=YOUR_PASSWORD,uid=1000,gid=1000,_netdev 0 0
# Then set this to the mounted path: MUSIC_DIR=/mnt/dmp/music/mainstream
MUSIC_DIR=/path/to/your/music/library

DATABASE_URL=postgresql://user:password@host:5432/dbname?connection_limit=20&pool_timeout=10

# Optional — enables server-side Redis cache (leave empty to disable)
# On the NAS it is automatically configured by docker-compose.yml.
REDIS_URL=

# Project root directory (absolute path to DMPv6 folder)
# Used by scripts to locate configuration and image directories
PROJECT_ROOT=/path/to/DMPv6

IMAGE_STORAGE=local
BACKUP_STORAGE=local

S3_IMAGE_BUCKET=
S3_BACKUPS_BUCKET=backups
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=  # Leave empty for AWS S3; set for S3-compatible services (e.g. Backblaze, MinIO)

# Public URL for accessing S3 images
# (e.g. https://your-bucket.s3.us-east-1.amazonaws.com)
S3_PUBLIC_URL=

# Fanart.tv API key
FANART_API_KEY=

# NAS server settings (for deploy-docker.sh)
SERVER_HOST=
SERVER_USER=
DEPLOY_PATH=/mnt/SSD/web/dmp
SSH_KEY_PATH=~/.ssh/nas

# ============================================================================
# Downloads
# ============================================================================
# All of these can also be configured via the Settings DB table.
# DB values override env vars when both are set.

# Where downloaded files are saved.
# - Local dev: the absolute path DMP writes into (e.g. /home/you/Downloads/dmp).
# - Docker deployment: set DOWNLOADS_DIR (host path) instead — docker-compose.yml
#   mounts it as /downloads into both slskd and web, and hard-codes DOWNLOADS_PATH=/downloads.
DOWNLOADS_PATH=/path/to/downloads

# Host-side directory that both dmp-web and dmp-slskd mount at /downloads.
# Only used by docker-compose.yml. Defaults to /mnt/SSD/Downloads on the NAS.
# If using a NAS path locally, it needs to be mounted in your filesystem
DOWNLOADS_DIR=/mnt/SSD/Downloads

# Folder template for downloads. Supported placeholders: {artist}, {album}, {year}
# Slashes create nested folders. If {year} is unknown, surrounding separators collapse.
DOWNLOAD_DIR_TEMPLATE='{artist}/{year} - {album}'

# Quality filters applied to search results (both sources)
# Comma-separated format list (e.g. "flac,mp3"); minimum bitrate in kbps
DOWNLOAD_FORMATS=flac,mp3
DOWNLOAD_MIN_BITRATE=320

# --- Source 1: slskd (Soulseek daemon REST API) ---
# Requires a running slskd instance. See docs/soulsync_analysis.md for setup.
SLSKD_URL=http://localhost:5030
SLSKD_API_KEY=

# --- Source 2: Deezer ---
# ARL cookie from a logged-in Deezer session (free account works — FLAC via Blowfish decryption)
# Get it from browser devtools → Application → Cookies → "arl" on deezer.com
DEEZER_ARL=

# --- Source 3: HiFi API ---
# No configuration needed — uses public proxy instances (FLAC, no account required).