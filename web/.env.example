# IMPORTANT NOTE
# Some variables (downloads, storage, Fanart.tv) can also be set via the Settings DB table.
# The DB values override the env vars.

# ────────────────────────────────────────────────
# ──────────────────── Config ────────────────────
# ────────────────────────────────────────────────

# Include connection_limit and pool_timeout query params for Prisma if necessary
DATABASE_URL=postgresql://user:password@host:5432/dbname?connection_limit=20&pool_timeout=10

# Redis server-side response caching. Leave empty to disable.
# Automatically configured by docker-compose.yml in production.
REDIS_URL=

# Required when using docker-compose.yml (no default - compose fails to start without it).
# Used to build REDIS_URL and as the redis-server --requirepass value.
REDIS_PASSWORD=

# Absolute path to music library root. Must be mounted locally (WSL2 can't use UNC paths directly).
# To mount NAS share in WSL2:
# sudo mount -t cifs //192.168.1.241/music /mnt/dmp/music -o username=MY_USER,uid=$(id -u),gid=$(id -g)
MUSIC_DIR=

# Absolute path to the DMP project folder.
# Used by Rust scripts to locate config and image directories.
PROJECT_ROOT=

# Directory containing script binaries (index, sync, audit, fix, etc.).
# Defaults to PROJECT_ROOT when unset (local dev with wrapper scripts).
# In Docker, set to /usr/local/bin where compiled binaries are installed.
SCRIPTS_DIR=

# Show the raw terminal sidebar for script/merge operations instead of the friendly
# progress panel. "true" or "false" (default false). DB Settings.showTerminal overrides this.
SHOW_TERMINAL=false

# ────────────────────────────────────────────────
# ──────────────── Remote Server ─────────────────
# ────────────────────────────────────────────────

# NAS IP or hostname for deployment.
SERVER_HOST=

# SSH user on the NAS.
SERVER_USER=

# Path to SSH private key for NAS access.
SSH_KEY_PATH=~/.ssh/nas

# Absolute path on the NAS where the app is deployed.
DEPLOY_PATH=

# Optional. Used when the catalogue data lives on a different machine.
# Proxies images and audio to this URL (e.g. http://192.168.1.241:3000) if files are missing locally.
# Affects /img/artists/*, /img/releases/*, and /api/audio/*.
REMOTE_SERVER_URL=

# ────────────────────────────────────────────────
# ──────────────────── Storage ───────────────────
# ────────────────────────────────────────────────

# Where images are stored. Values: local, s3, or both (local preferred, S3 as fallback).
IMAGE_STORAGE=local

# S3-compatible object storage (AWS S3, Backblaze B2, MinIO, etc). S3 is the default protocol.
STORAGE_IMAGE_BUCKET=
STORAGE_BACKUPS_BUCKET=backups

# Public base URL for serving images. Used by the frontend to build image URLs.
# Format: https://bucket-name.s3.region.amazonaws.com
STORAGE_PUBLIC_URL=

# Custom endpoint for non-AWS S3-compatible services. Leave empty for AWS S3.
# Example: https://s3.us-west-004.backblazeb2.com
STORAGE_ENDPOINT=

# AWS config
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ────────────────────────────────────────────────
# ───────────────── Downloads ────────────────────
# ────────────────────────────────────────────────
# Download settings can also be configured via the Settings DB table (DB values take priority).

# Where dmp + slskd write downloads. Use a `dmp` subfolder so the downloads root stays tidy
# (root holds only dmp/, .dmp-songkong/, SHARED/). Docker identity-mounts DOWNLOADS_DIR at the same
# path, so this is a real host path that's identical in .env, the Settings DB, and the container.
DOWNLOADS_PATH=/mnt/SSD/Downloads/dmp

# Host downloads volume, identity-mounted into web + slskd (host path == container path).
DOWNLOADS_DIR=/mnt/SSD/Downloads

# Finished downloads auto-land in {DOWNLOADS_PATH}/_ready (derived, not configurable) awaiting manual merge.

# SongKong spool/done dir (host cron <-> dmp), kept at the downloads volume root.
SONGKONG_STATE_DIR=/mnt/SSD/Downloads/.dmp-songkong

# Folder structure template for downloads. Placeholders: {artist}, {album}, {year}.
# Slashes create nested folders. If {year} is unknown, surrounding separators collapse.
DOWNLOAD_DIR_TEMPLATE='{artist}/{year} - {album}'

# Comma-separated list of accepted audio formats (e.g. flac,mp3).
DOWNLOAD_FORMATS=flac,mp3

# Minimum bitrate in kbps for download quality filtering.
DOWNLOAD_MIN_BITRATE=320

# URL of the slskd (Soulseek) instance.
SLSKD_URL=http://localhost:5030

# API key for slskd authentication.
SLSKD_API_KEY=


# ───────────── RuTracker (Prowlarr search + qBittorrent download) ─────────────
# Second download source. RuTracker has no public API, so search goes through Prowlarr
# (the *arr Torznab indexer proxy — same instance Lidarr uses; the RT login lives there, not here)
# and the torrent itself is downloaded by qBittorrent. When both sources are enabled, RuTracker is
# tried first and Soulseek is the fallback. All of these are also settable in Settings → Downloads.

# Prowlarr base URL + API key (Settings → General → Security in Prowlarr).
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=

# Optional: restrict searches to a single Prowlarr indexer id (the RuTracker indexer). Blank = all.
PROWLARR_INDEXER_ID=

# Max RuTracker searches per day. RuTracker's Prowlarr indexer caps searches/day (default 25); stay
# under it. When the budget is spent, fresh picks fall through to Soulseek (if enabled) or wait for the
# 24h window to roll over. Each search == one Prowlarr query.
RT_SEARCHES_PER_DAY=20

# qBittorrent WebUI URL + credentials.
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USER=
QBITTORRENT_PASS=

# qBittorrent-side save path for dmp torrents. Must resolve to {DOWNLOADS_PATH}/_torrents on the
# SHARED downloads volume so dmp can relocate the finished files by basename (like slskd). Only set
# this if qBittorrent mounts the volume at a different prefix than dmp; blank = use {DOWNLOADS_PATH}/_torrents.
QBITTORRENT_SAVE_PATH=


# ───────────── Always-on downloader / monitoring ─────────────
# All of these are also settable in the Settings → Monitoring/Downloads UI (DB wins over env).

# Master switch for the background workers (download trickle + catalogue-gap refresh + auto-merge).
MONITOR_ENABLED=true

# Per-instance, ENV-ONLY: only the instance with this set runs the background loop. The NAS/prod
# instance sets it (see docker-compose.yml); every other instance pointed at the same shared DB stays
# UI-only. Required because MONITOR_ENABLED lives in the shared DB and can't single out a primary.
# Dev: leave unset normally; set to true locally only when you want dev to drive the downloader.
MONITOR_PRIMARY=false

# Base reconcile tick (seconds): finalize in-flight downloads to READY. ENV ONLY, needs restart.
RECONCILE_SEC=5

# Unattended library scan (./index then ./sync), so new folders/releases show up without pressing a
# button. Off by default; Settings → Library wins over these. Runs only on the MONITOR_PRIMARY
# instance and is serialized against every other script run. Interval floor is 1 hour.
AUTO_SCAN_ENABLED=false
AUTO_SCAN_INTERVAL_HOURS=12

# Auto-merge ready releases into the library (off = manual Merge / Merge all gate).
AUTO_MERGE=false

# Cap on simultaneous active slskd transfers; the trickle worker tops up to this.
MAX_CONCURRENT_DOWNLOADS=5

# New MISSING releases searched per top-up run.
SEARCH_PICKS_PER_INTERVAL=3

# Minimum seconds between download top-up runs (throttle).
SEARCH_INTERVAL_SEC=60

# Monitored artists whose MusicBrainz catalogue is refreshed each gap run (round-robin).
GAPS_PICKS_PER_RUN=20

# Minutes between catalogue-gap runs.
GAPS_INTERVAL_MIN=5

# Days to wait before retrying a FAILED/UNAVAILABLE/INVALID release.
RETRY_COOLDOWN_DAYS=7

# Kill a transfer making no byte progress for this long (seconds). Lower abandons slow peers/big FLACs.
NO_PROGRESS_SEC=300

# Attempts before a release is ABANDONED (never auto-retried; manual Force retry still works).
MAX_DOWNLOAD_ATTEMPTS=3

# Auto-pause ALL downloads when the downloads volume drops below this many GB free.
DOWNLOADS_MIN_FREE_GB=5


# ───────────── SongKong enrichment (optional) ─────────────
# Needs the host drainer cron + a dedicated SongKong instance (see docs/features_downloader.md).

# Enrich finished downloads (AcoustID / MusicBrainz IDs / genres / cover art) before the library layout.
SONGKONG_ENABLED=false

# If SongKong never reports done within this many minutes, proceed unenriched (never strands a download).
SONGKONG_MAX_WAIT_MIN=30


# ────────────────────────────────────────────────
# ──────────────────── Other ─────────────────────
# ────────────────────────────────────────────────

# Secret for signing session cookies. MUST be set to a random string — if unset it falls back to a
# public hardcoded dev secret, making admin sessions forgeable. Generate: openssl rand -hex 32
SESSION_SECRET=

# API key for Fanart.tv. Used to fetch artist images during sync.
FANART_API_KEY=