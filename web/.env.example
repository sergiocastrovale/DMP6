# ------------------- BASE CONFIGURATION -------------------

# Local path to your music library.
# On WSL2, mount the NAS share first (see docs/truenas.md) then use the mount path.
# On TrueNAS (NAS .env), this is the host path Docker mounts into the container.
MUSIC_DIR=/path/to/your/music/library

DATABASE_URL=postgresql://user:password@host:5432/dbname?connection_limit=20&pool_timeout=10

# Optional — enables server-side Redis cache (leave empty to disable)
REDIS_URL=

# Project root directory (absolute path to DMPv6 folder)
# Used by scripts to locate configuration and image directories
PROJECT_ROOT=/path/to/DMPv6

# ------------------- IMAGE & BACKUP STORAGE -------------------

# Options: local, s3, or both
IMAGE_STORAGE=local
BACKUP_STORAGE=local

# S3 bucket names
S3_IMAGE_BUCKET=
S3_BACKUPS_BUCKET=backups

# AWS / S3-compatible credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=  # Leave empty for AWS S3; set for S3-compatible services (e.g. Backblaze, MinIO)

# Public URL for accessing S3 images
# (e.g. https://your-bucket.s3.us-east-1.amazonaws.com)
S3_PUBLIC_URL=

# ------------------- NAS DEPLOYMENT -------------------

# NAS server settings (for deploy-docker.sh)
SERVER_HOST=
SERVER_USER=
DEPLOY_PATH=/mnt/SSD/web/dmp
SSH_KEY_PATH=~/.ssh/nas

# ---------------------- PARTY MODE ----------------------

# Music Party Mode Configuration
# Enable party mode (set to true for both host and listener)
PARTY_ENABLED=false
# Party role: 'host' (local streaming) or 'listener' (remote listening)
PARTY_ROLE=host

# Party server URL (required for both host and listener)
# Host: URL of the remote server running as listener
# Listener: Leave empty or set to own domain
PARTY_URL=

# mediasoup WebRTC Configuration (required only for PARTY_ROLE=listener)
# Public IP address of the server for WebRTC connections
MEDIASOUP_ANNOUNCED_IP=127.0.0.1

# UDP port range for WebRTC media (must be open in firewall)
RTC_MIN_PORT=10000
RTC_MAX_PORT=10100

# ------------------------ SOULSEEK ------------------------

# Soulseek / slsk-batchdl settings (optional)
SLSK_USERNAME=
SLSK_PASSWORD=
SLSK_PATH=/path/to/sldl
SLSK_DOWNLOAD_DIR=/path/to/downloads
SLSK_ALLOWED_FORMATS=flac,mp3
SLSK_MIN_BITRATE=320
SLSK_NAME_FORMAT="{artist}/{year} - {album}/{track}. {title}"
SLSK_SEARCH_TIMEOUT=15