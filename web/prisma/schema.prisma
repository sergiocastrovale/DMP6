generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum IssueStatus {
  DETECTED
  PENDING
  PENDING_REVERT
  RESOLVED
  FAILED
}

enum ReleaseStatus {
  COMPLETE
  INCOMPLETE
  EXTRA_TRACKS
  MISSING_TRACKS
  MISSING
  UNKNOWN
  UNMATCHED
}

enum Role {
  VIEWER
  MANAGER
  ADMIN
}

// ---------------------------------------------------------------------------
// Artist
// ---------------------------------------------------------------------------

model Artist {
  id                  String                     @id @default(cuid())
  name                String
  slug                String                     @unique
  image               String?
  imageUrl            String?                    @db.Text
  musicbrainzId       String?
  completeness        Float?
  totalTracks         Int                        @default(0)
  totalFileSize       BigInt                     @default(0)
  lastSyncedAt        DateTime?
  lastTidiedAt        DateTime?
  lastIndexedAt       DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  urls                ArtistUrl[]                @relation("ArtistUrls")
  localReleases       LocalReleaseArtist[]
  mbReleases          MusicBrainzReleaseArtist[]
  downloadedReleases  DownloadedRelease[]
  genres              Genre[]                    @relation("ArtistGenres")
  country             String?                    @db.VarChar(2)
  syncHash            String?
  monitored           Boolean                    @default(false)
  manuallyAdded       Boolean                    @default(false)
  lastGapsCheckedAt   DateTime? // last catalogue-gap refresh (round-robin fairness at scale)
  trackRelatedArtists TrackRelatedArtist[]       @relation("ArtistRelatedTracks")
  orphanIssues        IssueOrphanArtist[]        @relation("OrphanArtistIssue")
  duplicateAIssues    IssueDuplicateArtist[]     @relation("DuplicateArtistA")
  duplicateBIssues    IssueDuplicateArtist[]     @relation("DuplicateArtistB")
  primaryArtistId     String?
  primaryArtist       Artist?                    @relation("ArtistPrimary", fields: [primaryArtistId], references: [id], onDelete: SetNull)
  connectedArtists    Artist[]                   @relation("ArtistPrimary")
  facts               ArtistFact[]

  @@index([musicbrainzId])
  @@index([completeness])
  @@index([createdAt])
  @@index([name]) // B-tree for ORDER BY name; trigram GIN index for ILIKE added via raw migration
  @@index([country])
  @@index([monitored, lastGapsCheckedAt])
  @@index([monitored])
  @@index([primaryArtistId])
}

// ---------------------------------------------------------------------------
// ArtistUrl
// ---------------------------------------------------------------------------

model ArtistUrl {
  id        String   @id @default(cuid())
  type      String
  url       String
  artistId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  artist    Artist   @relation("ArtistUrls", fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([artistId, type, url])
  @@index([artistId])
}

// ---------------------------------------------------------------------------
// Genre
// ---------------------------------------------------------------------------

model Genre {
  id       String               @id @default(cuid())
  name     String               @unique
  artists  Artist[]             @relation("ArtistGenres")
  releases MusicBrainzRelease[] @relation("ReleaseGenres")

  @@index([name])
}

// ---------------------------------------------------------------------------
// ReleaseType
// ---------------------------------------------------------------------------

model ReleaseType {
  id         String               @id @default(cuid())
  name       String               @unique
  slug       String               @unique
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  mbReleases MusicBrainzRelease[]
}

// ---------------------------------------------------------------------------
// MusicBrainzRelease
// ---------------------------------------------------------------------------

model MusicBrainzRelease {
  id                         String                     @id @default(cuid())
  title                      String                     @db.VarChar(500)
  typeId                     String
  year                       Int?
  musicbrainzId              String                     @unique
  releaseGroupId             String?
  disambiguation             String?
  editionLabel               String?
  releaseDate                String?
  packaging                  String?
  country                    String?
  format                     String?
  status                     ReleaseStatus              @default(UNKNOWN)
  statusReason               String?
  // Distinct MB media on this release (1 for a plain album, 9 for a 9CD box). Denormalized: the
  // artist releases endpoint is a hot list route and must not join MusicBrainzReleaseMedium just to
  // render a disc-count marker.
  mediumCount                Int                        @default(1)
  // The owning release-group's secondary types (Compilation, Live, Remix, Soundtrack, ...), copied
  // verbatim from the same MB payload allowlist::is_allowed already reads at bind time - not a new
  // API call, just no longer discarded. [] means an "original work": the signal the box-set
  // equivalence tier-3 matcher uses to disambiguate same-titled release-groups (docs/multidisk.md §5).
  releaseGroupSecondaryTypes String[]                   @default([])
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  localReleases              LocalRelease[]
  boxDiscs                   LocalRelease[]             @relation("BoxDiscs")
  artists                    MusicBrainzReleaseArtist[]
  type                       ReleaseType                @relation(fields: [typeId], references: [id])
  genres                     Genre[]                    @relation("ReleaseGenres")
  tracks                     MusicBrainzReleaseTrack[]
  media                      MusicBrainzReleaseMedium[]

  @@index([typeId])
  @@index([releaseGroupId])
}

// ---------------------------------------------------------------------------
// MusicBrainzReleaseMedium
// ---------------------------------------------------------------------------
//
// One row per MB medium (disc) on a release. MusicBrainz has no box-set entity - a box is one
// Release with N media - so this table is what makes a disc a first-class, queryable thing on our
// side. `equivalentReleaseId`/`equivalentReleaseGroupId` are NOT sent by MusicBrainz - MB stores no
// link from a box's disc to the standalone album it duplicates (`inc=release-rels` on a box returns
// `[]`). We derive it ourselves from shared recording MBIDs (see docs/box_sets.md, section 2.3) and
// recompute it wholesale via `sync --link-box-editions`, so a stale value self-heals on the next
// run rather than needing a cascade.
model MusicBrainzReleaseMedium {
  id                       String             @id @default(cuid())
  releaseId                String
  position                 Int
  title                    String?            @db.VarChar(500)
  format                   String?
  trackCount               Int                @default(0)
  // md5 of this medium's recording MBIDs, sorted. Null until the release has been (re-)synced with
  // recordingId populated on its tracks - see MusicBrainzReleaseTrack.recordingId.
  recordingFingerprint     String?            @db.VarChar(32)
  equivalentReleaseGroupId String?
  equivalentReleaseId      String?
  // Which medium of equivalentReleaseId this medium equals. NULL when the target is single-medium
  // (the common case - position is implicitly 1). Only meaningful when the target itself has
  // mediumCount > 1 (e.g. a box disc reprinting one disc of another multi-medium compilation).
  equivalentMediumPosition Int?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  release                  MusicBrainzRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([releaseId, position])
  @@index([releaseId])
  @@index([equivalentReleaseGroupId])
  @@index([recordingFingerprint])
}

// ---------------------------------------------------------------------------
// MusicBrainzReleaseTrack
// ---------------------------------------------------------------------------

model MusicBrainzReleaseTrack {
  id            String              @id @default(cuid())
  title         String              @db.VarChar(500)
  position      Int?
  discNumber    Int?
  durationMs    Int?
  musicbrainzId String?
  // MB recording id (stable across every release/medium that reprints this same recording - e.g. a
  // box-set disc and the standalone album it duplicates). NOT the same as musicbrainzId above,
  // which is the release-track id and is only unique within one release. Join key for
  // MusicBrainzReleaseMedium.equivalentReleaseId.
  recordingId   String?
  releaseId     String
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  release       MusicBrainzRelease  @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  localTracks   LocalReleaseTrack[]

  @@index([releaseId])
  @@index([musicbrainzId])
  @@index([recordingId])
}

// ---------------------------------------------------------------------------
// LocalRelease
// ---------------------------------------------------------------------------

model LocalRelease {
  id                         String                     @id @default(cuid())
  title                      String                     @db.VarChar(500)
  year                       Int?
  releaseId                  String?
  matchStatus                ReleaseStatus              @default(UNMATCHED)
  forcedComplete             Boolean                    @default(false)
  folderPath                 String?                    @db.Text
  groupKey                   String                     @db.VarChar(500)
  image                      String?
  imageUrl                   String?                    @db.Text
  totalDuration              Int?                       @default(0)
  totalFileSize              BigInt                     @default(0)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  downloadedFrom             String? // null = pristine library; 'slskd' = acquired via Soulseek
  // Which medium of releaseId this folder is. NULL = whole release (single-medium album, or a
  // folded multi-disc release whose LocalReleaseMember rows carry the disc numbers instead).
  mediumPosition             Int?
  // Dissolved-box-disc provenance: this folder physically sits on disc boxMediumPosition of box
  // release boxReleaseId, while releaseId points at the standalone album it reprints (or at the box
  // itself, for a rarities/no-equivalent disc, in which case mediumPosition also carries the disc
  // number and these two provenance columns are null). docs/multidisk.md §2/§5.
  boxReleaseId               String?
  boxMediumPosition          Int?
  box                        MusicBrainzRelease?        @relation("BoxDiscs", fields: [boxReleaseId], references: [id])
  artists                    LocalReleaseArtist[]
  release                    MusicBrainzRelease?        @relation(fields: [releaseId], references: [id])
  tracks                     LocalReleaseTrack[]
  members                    LocalReleaseMember[]
  enrichmentIssues           IssueEnrichmentGap[]
  favorites                  FavoriteRelease[]
  downloadedRelease          DownloadedRelease?
  duplicateReleaseAIssues    IssueDuplicateRelease[]    @relation("DuplicateReleaseA")
  duplicateReleaseBIssues    IssueDuplicateRelease[]    @relation("DuplicateReleaseB")
  mismatchedReleaseIdAIssues IssueMismatchedReleaseId[] @relation("MismatchedReleaseIdA")
  mismatchedReleaseIdBIssues IssueMismatchedReleaseId[] @relation("MismatchedReleaseIdB")
  facts                      ArtistFact[]

  @@unique([groupKey])
  @@index([releaseId])
  @@index([year])
  @@index([createdAt])
  @@index([downloadedFrom])
  @@index([boxReleaseId])
  @@index([title]) // B-tree for ORDER BY title; trigram GIN index for ILIKE added via raw migration
}

// ---------------------------------------------------------------------------
// LocalReleaseMember
// ---------------------------------------------------------------------------
//
// Sticky folder -> LocalRelease binding for a folded multi-disc/box release. Without this, a box
// whose disc folders are individually tagged as standalone albums (every track reads discNumber=1)
// would be re-split by the next plain `./index` run, since it skips known file paths and can't
// re-derive the fold from tags alone - churning the survivor row's identity (and its
// FavoriteRelease) on every scan. `index` looks a folder up here before building a group key, and
// `discNumber` is stamped from the MB medium position, not from the file's own tag.
model LocalReleaseMember {
  id             String       @id @default(cuid())
  localReleaseId String
  folderPath     String       @db.Text
  discNumber     Int?
  localRelease   LocalRelease @relation(fields: [localReleaseId], references: [id], onDelete: Cascade)

  @@unique([folderPath])
  @@index([localReleaseId])
}

// ---------------------------------------------------------------------------
// LocalReleaseArtist (many-to-many: a release can belong to multiple artists)
// ---------------------------------------------------------------------------

model LocalReleaseArtist {
  id             String       @id @default(cuid())
  localReleaseId String
  artistId       String
  createdAt      DateTime     @default(now())
  localRelease   LocalRelease @relation(fields: [localReleaseId], references: [id], onDelete: Cascade)
  artist         Artist       @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([localReleaseId, artistId])
  @@index([localReleaseId])
  @@index([artistId])
}

// ---------------------------------------------------------------------------
// MusicBrainzReleaseArtist (junction: MusicBrainzRelease ↔ Artist)
// ---------------------------------------------------------------------------

model MusicBrainzReleaseArtist {
  id        String             @id @default(cuid())
  releaseId String
  artistId  String
  createdAt DateTime           @default(now())
  release   MusicBrainzRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  artist    Artist             @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([releaseId, artistId])
  @@index([releaseId])
  @@index([artistId])
}

// ---------------------------------------------------------------------------
// LocalReleaseTrack
// ---------------------------------------------------------------------------

model LocalReleaseTrack {
  id                  String                   @id @default(cuid())
  title               String?                  @db.Text
  artist              String?                  @db.Text
  albumArtist         String?                  @db.Text
  album               String?                  @db.Text
  year                Int?
  genre               String?                  @db.Text
  duration            Int?
  bitrate             Int?
  sampleRate          Int?
  filePath            String                   @unique @db.VarChar(500)
  position            String?                  @db.Text
  trackNumber         Int?
  discNumber          Int?
  localReleaseId      String?
  mbTrackId           String?
  mbReleaseGroupId    String?
  mbReleaseId         String?
  mbAlbumArtistId     String?
  // Multi-value tag frames, kept in file order. artists[i] pairs with mbArtistIds[i] when the lengths
  // match - that pairing is an authoritative, pre-split artist list from Picard (see
  // common::mb::resolve tier 0), so no separator guessing or MB lookup is needed for those tracks.
  //
  // `@default([])` is required, not cosmetic. The migration created these NOT NULL DEFAULT ARRAY[],
  // but a bare `String[]` pushes as nullable with no default - so a database built from this schema
  // (a fresh install, or the vitest harness) handed NULL to the resolver, which decodes them as
  // Vec<String>, and artist resolution died with UnexpectedNullError before touching a single track.
  artists             String[]                 @default([])
  mbArtistIds         String[]                 @default([])
  albumArtists        String[]                 @default([])
  mbAlbumArtistIds    String[]                 @default([])
  fileSize            BigInt?
  mtime               DateTime?
  contentHash         String?                  @db.VarChar(32)
  metadata            Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  localRelease        LocalRelease?            @relation(fields: [localReleaseId], references: [id], onDelete: Cascade)
  mbTrack             MusicBrainzReleaseTrack? @relation(fields: [mbTrackId], references: [id])
  favorites           FavoriteTrack[]
  playlistTracks      PlaylistTrack[]
  trackRelatedArtists TrackRelatedArtist[]     @relation("TrackRelatedArtists")
  corruptedIssues     IssueCorruptedTpe2[]     @relation("CorruptedTrackIssue")
  missingIssues       IssueMissingMetadata[]   @relation("MissingMetadataIssue")
  facts               ArtistFact[]
  plays               LocalReleaseTrackPlay[]
  playEvents          PlayEvent[]
  // Trigram GIN index for title ILIKE and expression index on LOWER(genre) added via raw migration

  @@index([localReleaseId])
  @@index([mbTrackId])
  @@index([contentHash])
  @@index([mtime])
  @@index([year])
  @@index([year, genre])
  @@index([genre])
  @@index([localReleaseId, discNumber, trackNumber]) // Composite for ORDER BY discNumber, trackNumber within a release
  @@index([mbReleaseGroupId])
  @@index([mbReleaseId])
}

// ---------------------------------------------------------------------------
// LocalReleaseTrackPlay
// ---------------------------------------------------------------------------
//
// Per-user play counter - one row per (user, track), same pattern as FavoriteTrack. Plays are
// private per user, never shared (CLAUDE.md Data Model). Release/artist totals and "last played"
// are computed from this table at read time (server/utils/userPlays.ts), not stored denormalized.

model LocalReleaseTrackPlay {
  id           String            @id @default(cuid())
  userId       Int
  trackId      String
  playCount    Int               @default(0)
  lastPlayedAt DateTime
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  track        LocalReleaseTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([trackId])
  @@index([userId, lastPlayedAt])
  @@index([userId, playCount])
}

// ---------------------------------------------------------------------------
// PlayEvent
// ---------------------------------------------------------------------------
//
// One row per listen, per user - the log LocalReleaseTrackPlay's counter is folded from. Powers
// per-user stats, a yearly recap, "on this day" and Explore's familiarity/skip scoring. Cascade on
// user/track delete, same as FavoriteTrack/LocalReleaseTrackPlay - no snapshot, history for a track
// goes with the row. `counted` mirrors the same "meaningfully listened to" threshold as scrobbling
// (`helpers/playerLogic.ts`'s `shouldScrobble`) - the transition false->true is what increments
// LocalReleaseTrackPlay (server/utils/userPlays.ts's `recordPlay`), exactly once per event.

enum PlaySource {
  QUEUE
  PLAYLIST
  CATALOGUE
  EXPLORER
  RANDOM
  SUBSONIC
}

model PlayEvent {
  id              String            @id @default(cuid())
  userId          Int
  trackId         String
  startedAt       DateTime          @default(now())
  endedAt         DateTime?
  listenedSeconds Int               @default(0)
  trackDuration   Int?
  counted         Boolean           @default(false)
  skipped         Boolean           @default(false)
  source          PlaySource
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  track           LocalReleaseTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([userId, trackId, startedAt])
  @@index([trackId])
}

// ---------------------------------------------------------------------------
// ArtistFact — "Did you know..." trivia, fetched from Genius and cached. Once an
// artist has more than ARTIST_FACTS_DB_THRESHOLD (constants.ts) rows, the Genius
// API is skipped entirely and facts are served from here only.
// ---------------------------------------------------------------------------

model ArtistFact {
  id        String             @id @default(cuid())
  artistId  String
  releaseId String?
  trackId   String?
  text      String             @db.Text
  hash      String             @db.VarChar(40) // sha1(normalized text) - dedupe within an artist
  sourceUrl String?            @db.Text
  createdAt DateTime           @default(now())
  artist    Artist             @relation(fields: [artistId], references: [id], onDelete: Cascade)
  release   LocalRelease?      @relation(fields: [releaseId], references: [id], onDelete: Cascade)
  track     LocalReleaseTrack? @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([artistId, hash])
  @@index([artistId])
  @@map("ArtistFacts")
}

// ---------------------------------------------------------------------------
// TrackRelatedArtist
// ---------------------------------------------------------------------------

model TrackRelatedArtist {
  id        String            @id @default(cuid())
  trackId   String
  artistId  String
  createdAt DateTime          @default(now())
  track     LocalReleaseTrack @relation("TrackRelatedArtists", fields: [trackId], references: [id], onDelete: Cascade)
  artist    Artist            @relation("ArtistRelatedTracks", fields: [artistId], references: [id], onDelete: Cascade)

  @@unique([trackId, artistId])
  @@index([trackId])
  @@index([artistId])
}

// MusicBrainz artist-name resolution cache, written by the index resolver (scripts/index/src/resolve.rs)
// and read by sync's match ladder (scripts/common/src/mb/cache.rs). Caches hits AND misses so MB's
// ~1 req/s budget is paid once per name; `mbid IS NULL` means MusicBrainz confirmed it does not know
// the name, re-checked after a 30-day TTL rather than re-queried every run. It is also the only resume
// state `index --resolve-artists` has - the pass keeps no checkpoint of its own.
//
// Declared here as well as in migration 20260803124822_mb_artist_resolution: the migration created the
// table but the model was never added, so `prisma db push` built databases without it and the next
// `prisma migrate dev` would have generated a migration DROPPING it.
model MbArtistLookup {
  id         String   @id @default(cuid())
  name       String   @unique
  normalized String
  mbid       String?
  mbName     String?
  checkedAt  DateTime @default(now())

  @@index([normalized])
  @@index([checkedAt])
}

// ---------------------------------------------------------------------------
// Playlist
// ---------------------------------------------------------------------------

enum PlaylistType {
  MANUAL
  GENRE
  REGION
}

// GENRE/REGION rows are shared/generated (userId null, `./playlists` regen). MANUAL rows are
// per-user and private (userId set, Cascade on user delete) - see User-scoped favorites/playlists
// in CLAUDE.md. slug is unique among generated playlists and, separately, unique per owner - both
// enforced by partial/composite indexes added via raw migration (Prisma can't express either).
model Playlist {
  id          String             @id @default(cuid())
  name        String
  slug        String
  description String?            @db.Text
  image       String?
  type        PlaylistType       @default(MANUAL)
  generatorId String?            @unique
  generator   PlaylistGenerator? @relation(fields: [generatorId], references: [id], onDelete: Cascade)
  userId      Int?
  user        User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  tracks      PlaylistTrack[]

  @@unique([userId, slug])
  @@index([userId])
}

// Seeds for GENRE/REGION playlists, editable at /playlists/setup/generated. `terms` holds raw
// textarea lines: GENRE = keyword matching (a line prefixed `-` excludes), REGION = ISO 3166-1
// alpha-2 country codes. `./playlists` reads this table directly (see scripts/playlists).
model PlaylistGenerator {
  id          String       @id @default(cuid())
  type        PlaylistType
  name        String
  slug        String       @unique
  description String?      @db.Text
  terms       String[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  playlist    Playlist?
}

model PlaylistTrack {
  id         String            @id @default(cuid())
  position   Int
  playlistId String
  trackId    String
  createdAt  DateTime          @default(now())
  playlist   Playlist          @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      LocalReleaseTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId])
  @@index([trackId])
}

// ---------------------------------------------------------------------------
// Favorites
// ---------------------------------------------------------------------------

model FavoriteRelease {
  id        String       @id @default(cuid())
  userId    Int
  releaseId String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  release   LocalRelease @relation(fields: [releaseId], references: [id], onDelete: Cascade)

  @@unique([userId, releaseId])
  @@index([releaseId])
  @@index([userId])
}

model FavoriteTrack {
  id        String            @id @default(cuid())
  userId    Int
  trackId   String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     LocalReleaseTrack @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([trackId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Settings & Statistics
// ---------------------------------------------------------------------------

model SearchSource {
  id            String   @id @default(cuid())
  name          String   @unique
  baseUrl       String
  queryTemplate String
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Settings {
  id                     String    @id @default("main")
  // Library
  musicDir               String?
  // Opt-in unattended library scan (index + sync) run by the monitor plugin on the primary instance.
  // null = off; the interval falls back to AUTO_SCAN_INTERVAL_HOURS/12 when only the toggle is set.
  autoScanEnabled        Boolean?
  autoScanIntervalHours  Int?
  autoScanLastRunAt      DateTime?
  // Downloads
  slskdUrl               String?
  slskdApiKey            String?
  downloadsPath          String?
  downloadDirTemplate    String?
  downloadFormats        String?
  downloadMinBitrate     Int?
  downloadsEnabled       Boolean? // Soulseek acquisition on/off; null = enabled
  flacToMp3              Boolean? // convert FLAC downloads to MP3; null = env/default (FLAC_TO_MP3)
  flacToMp3Bitrate       Int?      @default(320) // target kbps for the FLAC->MP3 conversion (FLAC_TO_MP3_BITRATE)
  // Monitoring (all override the matching env var; null = use env/default)
  monitorEnabled         Boolean?
  monitorIntervalMin     Int?
  monitorCap             Int?
  monitorGapsHours       Int?
  retryCooldownDays      Int? // days to wait before retrying a FAILED/UNAVAILABLE/INVALID release; null = env/default
  noProgressSec          Int?
  maxDownloadAttempts    Int?
  songkongEnabled        Boolean? // enrich downloads with SongKong before layout; null = env/default
  // Always-on downloader (null = use env/default)
  autoMergeDownloads     Boolean? // auto-merge ready downloads into the library (default false)
  maxConcurrentDownloads Int? // cap on simultaneous active slskd transfers (default 5)
  searchPicksPerInterval Int? // missing releases queued per worker tick (default 3)
  searchIntervalSec      Int? // min seconds between download top-up runs (default 60)
  gapsPicksPerRun        Int? // monitored artists refreshed per catalogue-gap run (default 20)
  gapsIntervalMin        Int? // minutes between catalogue-gap runs (default 5)
  downloadsPaused        Boolean   @default(false) // global halt: no new queue/search/gaps/auto-merge
  downloadsPausedReason  String? // why paused: 'manual' | 'disk-full' | null
  // Storage
  imageStorage           String?
  storageImageBucket     String?
  storageBackupsBucket   String?
  awsRegion              String?
  awsAccessKeyId         String?
  awsSecretAccessKey     String?
  storageEndpoint        String?
  storagePublicUrl       String?
  // API Keys
  fanartApiKey           String?
  // Genius (trivia facts) - override GENIUS_CLIENT_ID/GENIUS_SECRET/GENIUS_ACCESS_TOKEN
  geniusClientId         String?
  geniusSecret           String?
  geniusAccessToken      String?
  // Run hashes (resumability)
  indexRunHash           String?
  syncRunHash            String?
  // Last.fm / Scrobbling
  lastfmApiKey           String?
  lastfmSecret           String?
  lastfmSessionKey       String?
  lastfmUsername         String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// DownloadedRelease — Soulseek acquisitions ready to merge / promoted
// ---------------------------------------------------------------------------

enum DownloadStatus {
  DOWNLOADING
  ENRICHING
  READY
  REJECTED
  PROMOTED
  FAILED
  ABANDONED
  UNAVAILABLE
  INVALID
  SEARCHING
}

model DownloadedRelease {
  id                     String         @id @default(cuid())
  artistId               String?
  mbReleaseId            String? // MusicBrainzRelease.id this fills (the MISSING target)
  releaseGroupId         String? // MB release-group id (denormalized)
  title                  String         @db.VarChar(500)
  year                   Int?
  slskUsername           String?
  quality                String? // format/bitrate, e.g. "MP3 320"
  files                  Json? // [{filename,size}] queued from slskd — lets the reconciler finalize
  stagingPath            String?        @db.Text // folder under DOWNLOADS_PATH
  status                 DownloadStatus @default(READY)
  attempts               Int            @default(0) // failed/no-result attempts; >= max -> ABANDONED (download-fail path only)
  priority               Int            @default(10) // 10 = freshest/highest; decremented per failure, floor 0; drives retry order
  bytesTransferred       BigInt         @default(0) // progress watermark for no-progress death
  lastProgressAt         DateTime? // last time bytes increased
  error                  String?        @db.Text
  localReleaseId         String?        @unique // set on promote
  // Re-download of an incomplete copy: the LocalRelease this download replaces, deleted (DB + files)
  // right before the new copy is moved into the library. Deliberately not a relation - a stale id
  // must degrade to a no-op at merge time, not a constraint error.
  replacesLocalReleaseId String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  artist                 Artist?        @relation(fields: [artistId], references: [id], onDelete: SetNull)
  localRelease           LocalRelease?  @relation(fields: [localReleaseId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([status, priority])
  @@index([artistId])
  @@index([mbReleaseId])
  @@index([createdAt])
}

model Statistics {
  id                            String    @id @default("main")
  artists                       Int       @default(0)
  mainArtists                   Int       @default(0)
  /// Artists owning no release - they exist only as MB-verified track credits ("appears on").
  /// Derived from LocalReleaseArtist at write time; there is deliberately no flag on Artist.
  creditArtists                 Int       @default(0)
  playtime                      BigInt    @default(0)
  tracks                        Int       @default(0)
  releases                      Int       @default(0)
  genres                        Int       @default(0)
  artistsSyncedWithMusicbrainz  Int       @default(0)
  releasesSyncedWithMusicbrainz Int       @default(0)
  artistsWithCoverArt           Int       @default(0)
  releasesWithCoverArt          Int       @default(0)
  totalFileSize                 BigInt    @default(0)
  lastScanStartedAt             DateTime?
  lastScanEndedAt               DateTime?
  lastSyncedArtist              String?
  lastSyncArgs                  Json?
  lastIndexedFolder             String?
  scanLockedBy                  String?
  scanLockedAt                  DateTime?
  scanPid                       Int?
  createdAt                     DateTime  @default(now())
  updatedAt                     DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// FolderScan - per-folder mtime cache for quick-mode change detection
// ---------------------------------------------------------------------------

model FolderScan {
  folderPath String   @id
  mtime      DateTime
  indexHash  String?
}

// ---------------------------------------------------------------------------
// Audit - issue detection and fix tracking
// ---------------------------------------------------------------------------

model AuditRun {
  id                        String                     @id @default(cuid())
  startedAt                 DateTime                   @default(now())
  finishedAt                DateTime?
  counts                    Json?
  createdAt                 DateTime                   @default(now())
  corruptedIssues           IssueCorruptedTpe2[]
  orphanIssues              IssueOrphanArtist[]
  duplicateIssues           IssueDuplicateArtist[]
  missingIssues             IssueMissingMetadata[]
  enrichmentIssues          IssueEnrichmentGap[]
  duplicateReleaseIssues    IssueDuplicateRelease[]
  mismatchedReleaseIdIssues IssueMismatchedReleaseId[]
}

model IssueCorruptedTpe2 {
  id            String            @id @default(cuid())
  auditRunId    String
  status        IssueStatus       @default(DETECTED)
  trackId       String
  currentValue  String
  proposedValue String
  confidence    String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  auditRun      AuditRun          @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  track         LocalReleaseTrack @relation("CorruptedTrackIssue", fields: [trackId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([auditRunId])
}

model IssueOrphanArtist {
  id         String      @id @default(cuid())
  auditRunId String
  status     IssueStatus @default(DETECTED)
  artistId   String
  reason     String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  auditRun   AuditRun    @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  artist     Artist      @relation("OrphanArtistIssue", fields: [artistId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([auditRunId])
}

model IssueDuplicateArtist {
  id         String      @id @default(cuid())
  auditRunId String
  status     IssueStatus @default(DETECTED)
  artistAId  String
  artistBId  String
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  auditRun   AuditRun    @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  artistA    Artist      @relation("DuplicateArtistA", fields: [artistAId], references: [id], onDelete: Cascade)
  artistB    Artist      @relation("DuplicateArtistB", fields: [artistBId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([auditRunId])
}

model IssueDuplicateRelease {
  id         String       @id @default(cuid())
  auditRunId String
  status     IssueStatus  @default(DETECTED)
  releaseAId String
  releaseBId String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  auditRun   AuditRun     @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  releaseA   LocalRelease @relation("DuplicateReleaseA", fields: [releaseAId], references: [id], onDelete: Cascade)
  releaseB   LocalRelease @relation("DuplicateReleaseB", fields: [releaseBId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([auditRunId])
}

model IssueMismatchedReleaseId {
  id         String       @id @default(cuid())
  auditRunId String
  status     IssueStatus  @default(DETECTED)
  releaseAId String
  releaseBId String
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  auditRun   AuditRun     @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  releaseA   LocalRelease @relation("MismatchedReleaseIdA", fields: [releaseAId], references: [id], onDelete: Cascade)
  releaseB   LocalRelease @relation("MismatchedReleaseIdB", fields: [releaseBId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([auditRunId])
}

model IssueMissingMetadata {
  id             String            @id @default(cuid())
  auditRunId     String
  status         IssueStatus       @default(DETECTED)
  trackId        String
  missingFields  String[]
  proposedValues Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  auditRun       AuditRun          @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  track          LocalReleaseTrack @relation("MissingMetadataIssue", fields: [trackId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([auditRunId])
}

model IssueEnrichmentGap {
  id             String       @id @default(cuid())
  auditRunId     String
  status         IssueStatus  @default(DETECTED)
  localReleaseId String
  // Missing field identifiers: "bpm" | "mood" | "acousticId" | "mbRelease" | "discogs" | "bandcamp" | "wikipedia"
  missingFields  String[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  auditRun       AuditRun     @relation(fields: [auditRunId], references: [id], onDelete: Cascade)
  localRelease   LocalRelease @relation(fields: [localReleaseId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([auditRunId])
  @@index([localReleaseId])
}

model FixHistory {
  id            String    @id @default(cuid())
  issueType     String
  issueId       String
  filePath      String    @db.Text
  previousState Json
  appliedState  Json
  appliedAt     DateTime  @default(now())
  revertedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([issueId])
  @@index([issueType, revertedAt])
  @@index([filePath])
}

// ---------------------------------------------------------------------------
// Auth
// ---------------------------------------------------------------------------

model User {
  id                 Int      @id @default(autoincrement())
  username           String   @unique
  email              String   @unique
  passwordHash       String
  role               Role     @default(VIEWER)
  mustChangePassword Boolean  @default(true)
  // Bumped on explicit logout/session-revoke to invalidate every previously issued session token
  // immediately (checked alongside the password-hash claim in isSessionStaleForUser).
  tokenVersion       Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  favoriteReleases FavoriteRelease[]
  favoriteTracks   FavoriteTrack[]
  playlists        Playlist[]
  trackPlays       LocalReleaseTrackPlay[]
  playEvents       PlayEvent[]
  apiKeys          UserApiKey[]
}

// OpenSubsonic `apiKey` auth (see docs/feature_subsonic.md) - the one credential form the /rest/*
// API accepts. bcrypt-hashed passwords (server/utils/password.ts) can't support Subsonic's classic
// t=md5(password+salt) scheme, so a client authenticates with one of these instead. Stored as a
// sha256 hex digest, not bcrypt - the key is high-entropy already and gets checked on every request,
// so a slow KDF would needlessly cost every /rest/* call. Survives a password change (PAT
// semantics); dies on user delete (Cascade) or explicit revoke (revokedAt set, row kept for the
// audit trail rather than deleted).
model UserApiKey {
  id         String    @id @default(cuid())
  userId     Int
  name       String
  keyHash    String    @unique
  prefix     String
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RolePermission {
  id         Int    @id @default(autoincrement())
  role       Role
  permission String

  @@unique([role, permission])
  @@index([role])
}

// Capped log of background monitor-loop issues (warn/error), persisted so any instance's UI can show
// them (the loop runs on one primary instance, the DB is shared). Pruned by age in the base tick.
//
// `archivedAt` is "dismissed from the flagged list", not "kept forever": the age-based prune in
// server/plugins/monitor.ts still removes archived rows once they pass the retention window, which is
// what keeps this table bounded. A nullable timestamp rather than a boolean because it records *when*
// something was cleared, and `archivedAt: null` is the natural "still flagged" filter.
model MonitorEvent {
  id         String    @id @default(cuid())
  level      String
  message    String
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  @@index([createdAt])
  @@index([archivedAt, createdAt])
}
